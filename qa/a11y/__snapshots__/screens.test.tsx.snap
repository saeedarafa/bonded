                                          Text text="❤️" {color=#2A1407 fontFamily=Outfit_600SemiBold fontSize=42 lineHeight=54}
                                        Text text="1" {color=#A3461A fontFamily=DMSans_500Medium fontSize=26 lineHeight=38}
                                      View role=button label="React with face with tears of joy" id=04-reaction-1 {backgroundColor=#F1E4D2 borderColor=#E2CFB5 borderWidth=1 borderRadius=999 minHeight=44 minWidth=44 paddingHorizontal=12 gap=4 flexDirection=row}
                                        View {}
                                          Text text="😂" {color=#2A1407 fontFamily=Outfit_600SemiBold fontSize=42 lineHeight=54}
