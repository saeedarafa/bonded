                                      View role=button label="Reacted with red heart, selected, 1" id=04-reaction-0 {backgroundColor=#FFE3D1 borderColor=#FF8A4C borderWidth=2 borderRadius=999 minHeight=44 minWidth=44 paddingHorizontal=12 gap=4 flexDirection=row}
