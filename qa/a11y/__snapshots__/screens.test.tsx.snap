exports[`P2 default structure snapshot in dark 1`] = `
"RNCSafeAreaProvider {}
  View {}
    RNCSafeAreaProvider {}
      View {}
        RNSScreenStack {}
          RNSScreen {}
            RNSScreenContentWrapper {backgroundColor=#1B140F}
              View {}
                RNSScreenStack {}
                  RNSScreen {}
                    RNSScreenContentWrapper {backgroundColor=#1B140F}
                      RNCSafeAreaView id=P2-screen {backgroundColor=#1B140F}
                        View id=P2-top {minHeight=56 paddingHorizontal=8 gap=8 flexDirection=row}
                          View {height=44 width=44}
                            View role=button label="Back" id=P2-top-back {height=44 width=44}
                              RNSVGSvgView hidden {backgroundColor=transparent borderWidth=0 height=24 width=24}
                                RNSVGGroup {}
                                  RNSVGPath {}
                          View {}
                            View role=progressbar label="Almost there" id=P2-progress {backgroundColor=#32261E borderRadius=3 height=6}
                              View {backgroundColor=#FF8A4C borderRadius=3 height=6 width=90%}
                          View {minWidth=44}
                            Text text="Almost there" {color=#CDBBA8 fontFamily=DMSans_500Medium fontSize=13 lineHeight=19}
                        View id=P2-keyboard {}
                          RCTScrollView id=P2-scroll {}
                            View {}
                              View id=P2-dismiss {paddingHorizontal=24 gap=24}
                                Text role=header id=P2-title text="Small daily moments keep couples close" {color=#F6ECDF fontFamily=Outfit_700Bold fontSize=30 lineHeight=35}
                                View role=image label="Bar chart. How often partners turned toward each other’s small moments of attention. Couples who stayed together: 86 percent. Couples who split up: 33 percent. Source: Gottman & Driver, newlywed couples study" id=P2-chart {backgroundColor=#261C16 borderColor=#3E3027 borderWidth=1 borderRadius=22 padding=18 gap=14}
                                  Text text="How often partners turned toward each other’s small moments of attention:" {color=#F6ECDF fontFamily=DMSans_600SemiBold fontSize=15 lineHeight=20}
                                  View id=P2-bar-stayed {gap=6}
                                    View {flexDirection=row}
                                      Text text="Couples who stayed together" {color=#F6ECDF fontFamily=DMSans_600SemiBold fontSize=15 lineHeight=20}
                                      Text id=P2-bar-stayed-value text="86%" {color=#FFA676 fontFamily=Outfit_600SemiBold fontSize=21 lineHeight=27}
                                    View {backgroundColor=#32261E borderRadius=7 height=14}
                                      View {backgroundColor=#FF8A4C borderRadius=7 height=14 width=0%}
                                  View id=P2-bar-split {gap=6}
                                    View {flexDirection=row}
                                      Text text="Couples who split up" {color=#F6ECDF fontFamily=DMSans_600SemiBold fontSize=15 lineHeight=20}
                                      Text id=P2-bar-split-value text="33%" {color=#CDBBA8 fontFamily=Outfit_600SemiBold fontSize=21 lineHeight=27}
                                    View {backgroundColor=#32261E borderRadius=7 height=14}
                                      View {backgroundColor=#D2B993 borderRadius=7 height=14 width=0%}
                                  Text id=P2-chart-source text="Gottman & Driver, newlywed couples study" {color=#CDBBA8 fontFamily=DMSans_500Medium fontSize=13 lineHeight=19}
                                View {}
                                  View label="36. Partners who took turns answering personal questions felt clearly closer afterwards. Source: Aron et al., 1997." id=P2-finding-personal {paddingVertical=12 gap=12 flexDirection=row}
                                    Text text="36" {color=#FFA676 fontFamily=Outfit_600SemiBold fontSize=21 lineHeight=27 minWidth=64}
                                    View {gap=2}
                                      Text text="Partners who took turns answering personal questions felt clearly closer afterwards." {color=#F6ECDF fontFamily=DMSans_400Regular fontSize=16 lineHeight=24}
                                      Text id=P2-finding-personal-source text="Aron et al., 1997" {color=#CDBBA8 fontFamily=DMSans_500Medium fontSize=13 lineHeight=19}
                                  View label="Daily. Warm responses when a partner shares something are linked to happier, longer-lasting relationships. Source: Gable et al., 2004 and 2006." id=P2-finding-warm {paddingVertical=12 gap=12 flexDirection=row}
                                    Text text="Daily" {color=#FFA676 fontFamily=Outfit_600SemiBold fontSize=21 lineHeight=27 minWidth=64}
                                    View {gap=2}
                                      Text text="Warm responses when a partner shares something are linked to happier, longer-lasting relationships." {color=#F6ECDF fontFamily=DMSans_400Regular fontSize=16 lineHeight=24}
                                      Text id=P2-finding-warm-source text="Gable et al., 2004 and 2006" {color=#CDBBA8 fontFamily=DMSans_500Medium fontSize=13 lineHeight=19}
                          View id=P2-footer {paddingHorizontal=24 gap=12}
                            Text id=P2-summary text="Bonded turns this into 3 minutes a day for Noor & Ari, at 12:30." {color=#F6ECDF fontFamily=DMSans_600SemiBold fontSize=15 lineHeight=20}
                            View role=button label="Start our plan" id=P2-start {backgroundColor=#FF8A4C borderColor=#3E3027 borderWidth=0 borderRadius=999 minHeight=56 paddingHorizontal=24 paddingVertical=8 gap=8 flexDirection=row opacity=1}
                              Text text="Start our plan" {color=#2A1407 fontFamily=Outfit_700Bold fontSize=17 lineHeight=22}
                    RNSScreenStackHeaderConfig {width=100% flexDirection=row}
            RNSScreenStackHeaderConfig {width=100% flexDirection=row}
"
