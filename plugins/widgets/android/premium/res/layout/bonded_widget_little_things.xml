<?xml version="1.0" encoding="utf-8"?>
<!-- 38c Little things (MOB-78, D59). Send buttons, "Sent" + Undo, locked preview (→ paywall), "Open Bonded". No answer or message text, ever. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bonded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bonded_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bonded_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/bonded_widget_little_things_label"
            android:textColor="@color/bonded_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/bonded_lock"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bonded_widget_lock"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bonded_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:textColor="@color/bonded_widget_text2"
            android:textSize="13sp" />

        <!-- Undo: 48dp touch target, only while the 5 s window is open. -->
        <TextView
            android:id="@+id/bonded_undo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/bonded_widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Spacer: RemoteViews inflate only allow-listed classes; a plain View throws (#286). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/bonded_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- #498: not baseline-aligned (a two-line label sat lower and was clipped) and every button
             fills the row's height, so the three line up at the top and bottom. -->

        <TextView
            android:id="@+id/bonded_send_hug"
            style="@style/BondedWidgetSendButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/bonded_widget_little_things_preview_send" />

        <TextView
            android:id="@+id/bonded_send_good_morning"
            style="@style/BondedWidgetSendButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bonded_send_goodnight"
            style="@style/BondedWidgetSendButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/bonded_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bonded_widget_cta"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:minHeight="48dp"
        android:textColor="@color/bonded_widget_on_you"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
