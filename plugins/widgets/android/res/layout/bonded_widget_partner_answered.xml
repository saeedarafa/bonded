<?xml version="1.0" encoding="utf-8"?>
<!-- 38b Partner answered (MOB-30/MOB-57, D47): lock, "Sam answered", "Reply to see theirs.". Never their answer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bonded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bonded_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bonded_mascot"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bonded_widget_mascot_waiting" />

        <!-- Spacer: RemoteViews inflate only allow-listed classes; a plain View throws (#286). -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bonded_widget_lock" />
    </LinearLayout>

    <TextView
        android:id="@+id/bonded_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/bonded_widget_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bonded_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:textColor="@color/bonded_widget_text2"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/bonded_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bonded_widget_cta"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/bonded_widget_on_you"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
