<?xml version="1.0" encoding="utf-8"?>
<!-- 38b Countdown (MOB-30/MOB-57, D47): "Your turn · 3:20:00 · to keep your streak", Answer now. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bonded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bonded_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- #295: the mascot sits in the header row, so the timer only gets the width left of it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bonded_turn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:textColor="@color/bonded_widget_you_text"
                    android:textSize="12sp" />

                <!-- #295: shrinks to fit; never wraps or cuts digits.
                     #340: the minimum is in dp, not sp. A 14sp minimum became 28dp at font
                     scale 2.0, wider than "HH:MM:SS" can be in the ~100dp column, so the last
                     digit was cut. The size is set by the box (about 26dp on a 2 x 2 cell) at
                     every font scale; the 12dp floor only matters on very narrow cells.
                     API 24-25 ignore autoSize and use the 16sp fallback (their largest font
                     scale is 1.3, which still fits). -->
                <Chronometer
                    android:id="@+id/bonded_timer"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:autoSizeMaxTextSize="28sp"
                    android:autoSizeMinTextSize="12dp"
                    android:autoSizeStepGranularity="1dp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical|start"
                    android:maxLines="1"
                    android:textColor="@color/bonded_widget_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:targetApi="26" />
            </LinearLayout>

            <ImageView
                android:id="@+id/bonded_mascot"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bonded_widget_mascot_waiting" />
        </LinearLayout>

        <TextView
            android:id="@+id/bonded_keep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/bonded_widget_text2"
            android:textSize="12sp" />

        <!-- Spacer: RemoteViews inflate only allow-listed classes; a plain View throws (#286). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/bonded_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bonded_widget_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/bonded_widget_on_you"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
