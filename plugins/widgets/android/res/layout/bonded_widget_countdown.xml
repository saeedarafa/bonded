<?xml version="1.0" encoding="utf-8"?>
<!-- 38b Countdown (MOB-30/MOB-57, D47): "Your turn · 3:20:00 · to keep your streak", Answer now. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bonded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bonded_widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bonded_turn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/bonded_widget_you_text"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/bonded_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/bonded_widget_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bonded_keep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/bonded_widget_text2"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/bonded_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bonded_widget_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/bonded_widget_on_you"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bonded_mascot"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/bonded_widget_mascot_waiting" />
</FrameLayout>
