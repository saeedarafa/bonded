#!/bin/sh
# Bonded: commits never credit an AI tool. Removes AI co-author trailers and
# "Generated with ..." lines that Claude Code, Codex, Copilot or ChatGPT may add.
# Enabled once per clone with: git config core.hooksPath .githooks
msg="$1"
tmp="$msg.bonded.$$"
grep -v -i -E \
  -e '^[[:space:]]*co-authored-by:.*(claude|anthropic|openai|codex|chatgpt|gpt|copilot|github-actions|\[bot\]|noreply@(anthropic|openai)\.com)' \
  -e '^[[:space:]]*(🤖[[:space:]]*)?generated (with|by) .*(claude|codex|chatgpt|copilot|openai)' \
  "$msg" > "$tmp"
# Drop trailing blank lines left behind.
awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print lines[i] }' "$tmp" > "$msg"
rm -f "$tmp"
