{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(supabase *)",
      "Bash(deno *)",
      "Bash(docker *)",
      "Bash(xcrun *)",
      "Bash(xcodebuild *)",
      "Bash(pod *)",
      "Bash(eas *)",
      "Bash(maestro *)",
      "Bash(adb *)",
      "Bash(engram *)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(security *)",
      "Bash(tccutil *)",
      "Bash(osascript *)",
      "Bash(launchctl *)",
      "Bash(crontab *)",
      "Bash(defaults write *)",
      "Bash(networksetup *)",
      "Bash(scutil *)",
      "Bash(spctl *)",
      "Bash(csrutil *)",
      "Bash(diskutil *)",
      "Bash(pfctl *)",
      "Bash(ssh-add *)",
      "Bash(ssh-keygen *)",
      "Bash(supabase db reset --linked *)",
      "Bash(supabase db reset --db-url *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/Pictures/**)",
      "Read(~/Desktop/**)",
      "Read(~/Documents/**)",
      "Read(~/Downloads/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Messages/**)",
      "Read(~/Library/Mail/**)",
      "Read(~/Library/Cookies/**)",
      "Read(~/Library/Safari/**)",
      "Read(~/Library/Application Support/Google/Chrome/**)",
      "Read(~/Library/Group Containers/**)",
      "Read(~/Library/Calendars/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zprofile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gitconfig)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/.claude/settings.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "docker",
      "supabase",
      "xcrun",
      "xcodebuild",
      "pod",
      "eas",
      "maestro",
      "adb"
    ],
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/Pictures",
        "~/Desktop",
        "~/Documents",
        "~/Downloads",
        "~/Library/Keychains",
        "~/Library/Messages",
        "~/Library/Mail",
        "~/Library/Cookies",
        "~/Library/Safari",
        "~/Library/Application Support/Google/Chrome",
        "~/Library/Group Containers",
        "~/Library/Calendars",
        "~/Library/Mobile Documents"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "*.npmjs.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "expo.dev",
        "*.expo.dev",
        "*.expo.io",
        "api.supabase.com",
        "*.supabase.co",
        "*.supabase.com",
        "deno.land",
        "*.deno.land",
        "jsr.io",
        "*.jsr.io",
        "esm.sh",
        "*.cocoapods.org",
        "dl.google.com",
        "*.gradle.org",
        "repo.maven.apache.org",
        "api.revenuecat.com",
        "sentry.io",
        "*.sentry.io",
        "*.posthog.com",
        "hellobonded.com",
        "*.hellobonded.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "( [ -f .engram/graph.json ] || [ -f .graphify/graph.json ] ) && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"engram: knowledge graph at .engram/. For focused questions, run `engram query \\\"<question>\\\"` (scoped subgraph, usually much smaller than GRAPH_REPORT.md) instead of grepping raw files. Read GRAPH_REPORT.md only for broad architecture context.\"}}' || true"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "HIT=$(node -e \"var chunks=[];process.stdin.on('data',function(c){chunks.push(c);});process.stdin.on('end',function(){try{var d=JSON.parse(Buffer.concat(chunks).toString());var t=d.tool_input||d;var s=(String(t.file_path||'')+' '+String(t.pattern||'')+String(t.path||'')).toLowerCase().replace(/\\\\\\\\\\\\\\\\/g,'/');var exts=['.py','.js','.ts','.tsx','.jsx','.go','.rs','.java','.rb','.c','.h','.cpp','.hpp','.cs','.kt','.swift','.php','.lua','.sh','.md','.rst','.txt','.mdx'];if(!s.includes('.engram/')&&!s.includes('.graphify/')&&!s.includes('graphify-out/')&&exts.some(function(e){return s.includes(e);})){process.stdout.write('1');}}catch(e){}});\" 2>/dev/null || true); if [ \"$HIT\" = 1 ] && ( [ -f .engram/graph.json ] || [ -f .graphify/graph.json ] ); then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"engram: knowledge graph at .engram/. For codebase questions, run `engram query \\\"<question>\\\"` (scoped subgraph) instead of reading source files one by one. Read raw files to modify specific code or debug.\"}}'; fi || true"
          }
        ]
      }
    ]
  }
}
