# Edge function secrets. Copy to supabase/functions/.env (git-ignored) and load with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
INTERNAL_FUNCTION_SECRET=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_REST_API_KEY=
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
# BE-51: PostHog person + event deletion on delete-account. Personal API key with scope
# person:write (not the public project key), the numeric project id, and the private API host
# (EU, default https://eu.posthog.com; only eu.posthog.com or us.posthog.com are accepted).
# Leave empty to skip; queued deletions run once set.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://eu.posthog.com
