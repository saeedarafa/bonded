# App (Expo). Copy to .env. Only EXPO_PUBLIC_* values reach the bundle, so never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# RevenueCat public SDK keys (appl_… / goog_…, MOB-19). Public by design; the REST/secret key never goes here.
# Empty = the paywall shows "Not available right now" (CI, Jest, local without a RevenueCat project).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# PostHog (MOB-24, D54, docs/ANALYTICS.md): the project API key (phc_…, public by design: it can
# only send events). Empty = analytics is a no-op (dev, CI, Jest). EU host only.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# 1 = every event carries is_test_account: true (E2E and internal test builds), so PostHog can
# filter them out. Leave empty for production.
EXPO_PUBLIC_ANALYTICS_TEST_BUILD=
# D63 (MOB-87): 1 = masked PostHog session replay (dev build only; needs @posthog/react-native-plugin).
# Keep it empty for every release build until SEC-23 approves and QA-54 passes.
EXPO_PUBLIC_ANALYTICS_REPLAY=
EXPO_PUBLIC_SENTRY_DSN=
# D30: invite links https://hellobonded.com/j/BND4827?t=… and the terms / privacy pages. Leave empty
# for simulator and QA builds (qa/e2e): invite links then use bonded:// and work without the website.
EXPO_PUBLIC_INVITE_DOMAIN=hellobonded.com
# D62 (MOB-85): Settings 40 "Send feedback" opens an email to this address. Only an address at the
# app's domain is used; empty hides the row.
EXPO_PUBLIC_SUPPORT_EMAIL=support@hellobonded.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id (com.googleusercontent.apps.…): read by app.config.ts for the iOS URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# EAS project id (ACCOUNTS 3, MOB-02): Expo push tokens need it (MOB-15). Empty = no push token.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Voice answers (MOB-55, D46): 1 shows the Write | Voice switch on 19 and lists voice on the paywalls.
# Leave empty for production until BE-43 (voice caps and cleanup) is live.
EXPO_PUBLIC_SHIP_VOICE=
# Little things (MOB-58, D48): 1 shows the little-things button on Today and lists "more little
# things" on the paywalls. Leave empty for production until receiving (MOB-59) and push (BE-45) land.
EXPO_PUBLIC_SHIP_LITTLE_THINGS=
# Premium History (MOB-71, D55): 1 lists "History: Last 2 days / Everything" on the paywalls (17, 34).
# Leave empty for production until BE-55's History lock is live there.
EXPO_PUBLIC_SHIP_PREMIUM_HISTORY=
