# App (Expo). Copy to .env. Only EXPO_PUBLIC_* values reach the bundle, so never put secrets here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_INVITE_DOMAIN=[your-domain]
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Reversed iOS client id (com.googleusercontent.apps.…): read by app.config.ts for the iOS URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
